# Phase 0: Dokumentation des künftigen Konfigurationsvertrags, NICHT lauffähig.
# Keine dieser projektspezifischen Variablen ist automatisch eine Upstream-Variable.
# Keine echten Werte eintragen oder .env/Secret-Dateien committen.
GARAGE_TIME_ZONE=Europe/Berlin
GARAGE_PUBLIC_HOSTNAME=
GARAGE_LUBELOGGER_BASE_URL=
GARAGE_PAPERLESS_BASE_URL=
GARAGE_TELEGRAM_ALLOWED_USER_ID=
GARAGE_TELEGRAM_PRIVATE_CHAT_ID=
GARAGE_GOOGLE_CALENDAR_ID=
# Images künftig als geprüfte Version plus sha256-Digest fixieren.
GARAGE_LUBELOGGER_IMAGE=
GARAGE_CLOUDFLARED_IMAGE=
GARAGE_DATABASE_IMAGE=
# Pfade auf getrennt verwaltete Secret-Dateien; keine Token-Werte.
GARAGE_LUBELOGGER_CREDENTIAL_FILE=
GARAGE_PAPERLESS_TOKEN_FILE=
GARAGE_TELEGRAM_TOKEN_FILE=
GARAGE_CALENDAR_CREDENTIAL_FILE=
GARAGE_TUNNEL_CREDENTIAL_FILE=
GARAGE_DATABASE_CREDENTIAL_FILE=
# Anbieter, Schlüssel und Freigabe für KI bleiben in Version 2.0 offen.
