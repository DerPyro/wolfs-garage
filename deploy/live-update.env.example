# Copy outside the repository to /etc/wolfs-garage/live.env and protect it
# with root ownership and mode 0600. Replace every example path/name locally.
GARAGE_COMPOSE_FILE=/etc/wolfs-garage/compose.live.yaml
GARAGE_RELEASE_ROOT=/opt/wolfs-garage/releases
GARAGE_UPDATE_STATE_DIR=/var/lib/wolfs-garage-updater
GARAGE_DATA_VOLUME=replace-with-existing-garage-volume
GARAGE_ORIGIN_NETWORK=replace-with-existing-proxy-network
GARAGE_PUBLIC_ORIGIN=https://garage.example.invalid
GARAGE_IMAGE_PREFIX=wolfs-garage-live
GARAGE_IMAGE=wolfs-garage-live:bootstrap
GARAGE_HEALTH_TIMEOUT=120
# Both hook paths must name root-owned executable files outside the repo.
# Prepare routes requests to maintenance and waits for active writes to drain;
# finish restores normal proxy routing. Hooks receive no arguments or secrets.
GARAGE_MAINTENANCE_PREPARE=/etc/wolfs-garage/maintenance-prepare
GARAGE_MAINTENANCE_FINISH=/etc/wolfs-garage/maintenance-finish
