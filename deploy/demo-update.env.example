# Install this file as /etc/wolfs-garage-demo/update.env, root:root mode 0600.
DEMO_COMPOSE_FILE=/etc/wolfs-garage-demo/compose.runtime.yaml
DEMO_ENV_FILE=/etc/wolfs-garage-demo/demo.env
DEMO_CONNECTOR_FILE=/etc/wolfs-garage-demo/connector.yaml
DEMO_RELEASE_ROOT=/opt/wolfs-garage-demo/releases
DEMO_STATE_DIR=/var/lib/wolfs-garage-demo-updater
DEMO_IMAGE_PREFIX=wolfs-garage-demo
DEMO_HEALTH_TIMEOUT=120
DEMO_ORIGIN=https://demo.example.org
DEMO_PROJECT=wolfs-garage-demo
