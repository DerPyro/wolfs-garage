server {
    listen 8080 default_server;
    server_name _;
    if ($http_host != "${GARAGE_DEMO_HOST}") { return 421; }
    client_max_body_size 16k;
    client_header_timeout 10s;
    client_body_timeout 10s;
    keepalive_timeout 15s;
    send_timeout 15s;
    limit_req_status 429;
    add_header Retry-After $demo_retry_after always;

    location = /healthz {
        proxy_pass http://demo_app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
    location ^~ /garage-api/ {
        limit_req zone=demo_api_reads burst=40 nodelay;
        limit_req zone=demo_api_client_writes burst=10 nodelay;
        limit_req zone=demo_api_global_writes burst=10 nodelay;
        proxy_pass http://demo_app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 10s;
    }
    location / {
        proxy_pass http://demo_app:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_connect_timeout 3s;
        proxy_read_timeout 20s;
        proxy_send_timeout 10s;
    }
}
