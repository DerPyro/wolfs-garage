{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wolfs Garage proposed contract types",
  "description": "Design only; own future API. No service exists. All examples synthetic. Semantic checks are defined in api-contracts.md.",
  "$defs": {
    "Money": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "amountMinor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000
        },
        "currency": {
          "const": "EUR"
        }
      },
      "required": [
        "amountMinor",
        "currency"
      ]
    },
    "OdometerPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kilometers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "recordedOn": {
          "type": "string",
          "format": "date"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "correctionReason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "kilometers",
        "recordedOn"
      ]
    },
    "MaintenancePayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "performedOn": {
          "type": "string",
          "format": "date"
        },
        "kilometers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "kind": {
          "enum": [
            "service",
            "repair"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "totalCost": {
          "$ref": "#/$defs/Money"
        },
        "workKind": {
          "enum": [
            "self",
            "workshop",
            "unknown"
          ]
        },
        "workshopName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "laborMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "completedTaskIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "maxItems": 20
        },
        "partUsages": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "providerSupplyId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "quantity": {
                "type": "string",
                "pattern": "^[0-9]+(?:\\.[0-9]{1,3})?$"
              }
            },
            "required": [
              "providerSupplyId",
              "quantity"
            ]
          }
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": [
        "performedOn",
        "kilometers",
        "kind",
        "description",
        "totalCost",
        "workKind"
      ]
    },
    "ProblemPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "observedOn": {
          "type": "string",
          "format": "date"
        },
        "kilometers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "severity": {
          "enum": [
            "observation",
            "repair_required",
            "critical"
          ]
        }
      },
      "required": [
        "observedOn",
        "title",
        "description",
        "severity"
      ]
    },
    "ProblemEventPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problemId": {
          "type": "string",
          "format": "uuid"
        },
        "eventType": {
          "enum": [
            "observation",
            "diagnostic_attempt",
            "repair_attempt",
            "status_changed",
            "severity_changed"
          ]
        },
        "occurredOn": {
          "type": "string",
          "format": "date"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "status": {
          "enum": [
            "open",
            "observing",
            "resolved"
          ]
        },
        "severity": {
          "enum": [
            "observation",
            "repair_required",
            "critical"
          ]
        }
      },
      "required": [
        "problemId",
        "eventType",
        "occurredOn",
        "description"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "status_changed"
              }
            }
          },
          "then": {
            "required": [
              "status"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "eventType": {
                "const": "severity_changed"
              }
            }
          },
          "then": {
            "required": [
              "severity"
            ]
          }
        }
      ]
    },
    "HuCompletionPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "performedOn": {
          "type": "string",
          "format": "date"
        },
        "kilometers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000000
        },
        "confirmedNextDueOn": {
          "type": "string",
          "format": "date"
        },
        "basis": {
          "enum": [
            "confirmed_document",
            "manual_confirmed_rule"
          ]
        },
        "sourceReferenceId": {
          "type": "string",
          "format": "uuid"
        },
        "notes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "duePrecision": {
          "enum": [
            "day",
            "month"
          ]
        },
        "confirmedNextDueMonth": {
          "type": "string",
          "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
        }
      },
      "required": [
        "taskId",
        "performedOn",
        "basis",
        "sourceReferenceId",
        "duePrecision"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "duePrecision": {
                "const": "day"
              }
            }
          },
          "then": {
            "required": [
              "confirmedNextDueOn"
            ],
            "not": {
              "required": [
                "confirmedNextDueMonth"
              ]
            }
          },
          "else": {
            "required": [
              "confirmedNextDueMonth"
            ],
            "not": {
              "required": [
                "confirmedNextDueOn"
              ]
            }
          }
        }
      ]
    },
    "DocumentLinkPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paperlessInstanceId": {
          "type": "string",
          "format": "uuid"
        },
        "documentId": {
          "type": "integer",
          "minimum": 1
        },
        "category": {
          "enum": [
            "registration",
            "inspection",
            "invoice",
            "insurance",
            "other"
          ]
        },
        "targetKind": {
          "enum": [
            "vehicle",
            "problem",
            "maintenance"
          ]
        },
        "targetId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "paperlessInstanceId",
        "documentId",
        "category",
        "targetKind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "targetKind": {
                "enum": [
                  "problem",
                  "maintenance"
                ]
              }
            }
          },
          "then": {
            "required": [
              "targetId"
            ]
          }
        }
      ]
    },
    "DraftRequest": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "recordOdometerReading"
            },
            "vehicleId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVehicleRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "$ref": "#/$defs/OdometerPayload"
            }
          },
          "required": [
            "operation",
            "vehicleId",
            "expectedVehicleRevision",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "recordMaintenance"
            },
            "vehicleId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVehicleRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "$ref": "#/$defs/MaintenancePayload"
            }
          },
          "required": [
            "operation",
            "vehicleId",
            "expectedVehicleRevision",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "createProblem"
            },
            "vehicleId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVehicleRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "$ref": "#/$defs/ProblemPayload"
            }
          },
          "required": [
            "operation",
            "vehicleId",
            "expectedVehicleRevision",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "appendProblemEvent"
            },
            "vehicleId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVehicleRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "$ref": "#/$defs/ProblemEventPayload"
            }
          },
          "required": [
            "operation",
            "vehicleId",
            "expectedVehicleRevision",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "recordHuCompletion"
            },
            "vehicleId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVehicleRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "$ref": "#/$defs/HuCompletionPayload"
            }
          },
          "required": [
            "operation",
            "vehicleId",
            "expectedVehicleRevision",
            "payload"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation": {
              "const": "linkDocument"
            },
            "vehicleId": {
              "type": "string",
              "format": "uuid"
            },
            "expectedVehicleRevision": {
              "type": "integer",
              "minimum": 0
            },
            "payload": {
              "$ref": "#/$defs/DocumentLinkPayload"
            }
          },
          "required": [
            "operation",
            "vehicleId",
            "expectedVehicleRevision",
            "payload"
          ]
        }
      ]
    },
    "ConfirmRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expectedCommandRevision": {
          "type": "integer",
          "minimum": 0
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmationNonce": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        }
      },
      "required": [
        "expectedCommandRevision",
        "payloadHash",
        "confirmationNonce"
      ]
    },
    "DraftResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "commandRevision": {
          "type": "integer",
          "minimum": 0
        },
        "vehicleId": {
          "type": "string",
          "format": "uuid"
        },
        "operation": {
          "enum": [
            "recordOdometerReading",
            "recordMaintenance",
            "createProblem",
            "appendProblemEvent",
            "recordHuCompletion",
            "linkDocument"
          ]
        },
        "status": {
          "const": "awaiting_confirmation"
        },
        "payloadHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        },
        "confirmationNonce": {
          "type": "string",
          "minLength": 32,
          "maxLength": 128
        },
        "preview": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "warnings": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      },
      "required": [
        "commandId",
        "commandRevision",
        "vehicleId",
        "operation",
        "status",
        "payloadHash",
        "expiresAt",
        "confirmationNonce",
        "preview",
        "warnings"
      ]
    },
    "OperationResult": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operationId": {
          "type": "string",
          "format": "uuid"
        },
        "provider": {
          "enum": [
            "garage",
            "lubelogger",
            "paperless",
            "google_calendar",
            "telegram"
          ]
        },
        "status": {
          "enum": [
            "pending",
            "in_flight",
            "succeeded",
            "failed",
            "uncertain",
            "cancelled"
          ]
        },
        "effect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "errorCode": {
          "enum": [
            "provider_unavailable",
            "provider_rejected",
            "transport_outcome_unknown",
            "conflict",
            "permission_revoked",
            "unsupported_capability"
          ]
        }
      },
      "required": [
        "operationId",
        "provider",
        "status",
        "effect"
      ]
    },
    "CommandStatus": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "type": "string",
          "format": "uuid"
        },
        "commandRevision": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "enum": [
            "awaiting_confirmation",
            "accepted",
            "executing",
            "succeeded",
            "partially_succeeded",
            "failed",
            "uncertain",
            "cancelled",
            "expired",
            "conflict"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "operations": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/OperationResult"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "commandId",
        "commandRevision",
        "status",
        "updatedAt",
        "operations",
        "summary"
      ]
    },
    "ApiError": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "unauthenticated",
            "forbidden",
            "not_found",
            "validation_failed",
            "unsupported_capability",
            "stale_revision",
            "idempotency_conflict",
            "confirmation_expired",
            "confirmation_invalid",
            "rate_limited",
            "provider_unavailable",
            "unexpected_failure"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "correlationId": {
          "type": "string",
          "format": "uuid"
        },
        "retryable": {
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message",
        "correlationId",
        "retryable"
      ]
    },
    "DueTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "vehicleId": {
          "type": "string",
          "format": "uuid"
        },
        "dueRevision": {
          "type": "integer",
          "minimum": 0
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "dueOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "dueKilometers": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "future",
            "due_today",
            "due_now",
            "overdue",
            "unknown"
          ]
        },
        "basis": {
          "enum": [
            "confirmed",
            "manual",
            "unknown"
          ]
        },
        "readAt": {
          "type": "string",
          "format": "date-time"
        },
        "stale": {
          "type": "boolean"
        },
        "requiresReview": {
          "type": "boolean"
        },
        "duePrecision": {
          "enum": [
            "day",
            "month",
            "not_applicable"
          ]
        },
        "forecast": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Forecast"
            }
          ]
        }
      },
      "required": [
        "taskId",
        "vehicleId",
        "dueRevision",
        "description",
        "dueOn",
        "dueKilometers",
        "status",
        "basis",
        "readAt",
        "stale",
        "requiresReview",
        "duePrecision",
        "forecast"
      ]
    },
    "TaskPage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/DueTask"
          }
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 2000
        }
      },
      "required": [
        "items",
        "nextCursor"
      ]
    },
    "Forecast": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available"
            },
            "estimatedDueOn": {
              "type": "string",
              "format": "date"
            },
            "basis": {
              "const": "estimate"
            },
            "measurementRefs": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "rateDistanceKm": {
              "type": "integer",
              "minimum": 1
            },
            "rateElapsedDays": {
              "type": "integer",
              "minimum": 1
            },
            "algorithmRevision": {
              "type": "integer",
              "minimum": 1
            },
            "projectionRevision": {
              "type": "integer",
              "minimum": 0
            },
            "dataAsOf": {
              "type": "string",
              "format": "date"
            },
            "calculatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "limitation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          },
          "required": [
            "status",
            "estimatedDueOn",
            "basis",
            "measurementRefs",
            "rateDistanceKm",
            "rateElapsedDays",
            "algorithmRevision",
            "projectionRevision",
            "dataAsOf",
            "calculatedAt",
            "limitation"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "insufficient_history",
                "stale_readings",
                "conflicting_readings",
                "unknown_unit",
                "zero_rate",
                "no_km_target"
              ]
            },
            "projectionRevision": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "status",
            "reason",
            "projectionRevision"
          ]
        }
      ]
    }
  }
}
